<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591;NU1608</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Project is not a test project -->
    <SonarQubeTestProject>false</SonarQubeTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="dist\**" />
    <Content Remove="dist\**" />
    <EmbeddedResource Remove="dist\**" />
    <None Remove="dist\**" />
    <!-- Admin Shell plugin: Vue sources in vue/, built into plugins/admin-shell/ -->
    <Compile Remove="vue\**" />
    <Content Remove="vue\**" />
    <EmbeddedResource Remove="vue\**" />
    <None Remove="vue\**" />
    <Content Remove="plugins\**" />
    <None Remove="plugins\**" />
    <AdminShellPlugin Include="plugins\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VirtoCommerce.EnvironmentsCompare.Core\VirtoCommerce.EnvironmentsCompare.Core.csproj" />
    <ProjectReference Include="..\VirtoCommerce.EnvironmentsCompare.Data\VirtoCommerce.EnvironmentsCompare.Data.csproj" />
    <ProjectReference Include="..\VirtoCommerce.EnvironmentsCompare.Data.MySql\VirtoCommerce.EnvironmentsCompare.Data.MySql.csproj" />
    <ProjectReference Include="..\VirtoCommerce.EnvironmentsCompare.Data.PostgreSql\VirtoCommerce.EnvironmentsCompare.Data.PostgreSql.csproj" />
    <ProjectReference Include="..\VirtoCommerce.EnvironmentsCompare.Data.SqlServer\VirtoCommerce.EnvironmentsCompare.Data.SqlServer.csproj" />
  </ItemGroup>

  <Target Name="CopyCustomContentOnPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(AdminShellPlugin)" DestinationFiles="$(PublishDir)\..\%(Identity)" />
  </Target>
</Project>
